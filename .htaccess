# PromptTai Tools - Root .htaccess
# Secure - removed external error redirects to earncolour.xyz
# For cPanel: if document root is set to /public, this file is not needed
# If document root is project root, rewrite to public

<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

Options -Indexes

# Protect sensitive files
<FilesMatch "(\.env|config\.php|\.git|\.htaccess|composer\.json|composer\.lock)$">
  Require all denied
</FilesMatch>

RewriteEngine On

# If request is for public folder directly, serve it
RewriteCond %{REQUEST_URI} ^/public/
RewriteRule ^public/(.*)$ public/$1 [L]

# Deny access to sensitive dirs from root
RewriteRule ^(app|database|storage|legacy|docs)/ - [F,L]

# Rewrite all to public/index.php if not existing file in public
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/index.php [QSA,L]

# Local error docs, static to avoid loop
ErrorDocument 404 /public/404.html
ErrorDocument 403 /public/404.html
ErrorDocument 500 /public/500.html

