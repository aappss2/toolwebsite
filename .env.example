# PromptTai Tools - Environment Configuration
# Copy to .env and fill real values - NEVER commit .env to git
# Place .env outside public root or protect via .htaccess

APP_ENV=production
APP_DEBUG=false
APP_DOMAIN=https://tool.prompttai.com

# Database - MySQL for production, SQLite for dev fallback
DB_TYPE=mysql
DB_HOST=localhost
DB_NAME=prompttai_tools
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Razorpay - Get from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Stripe (future)
STRIPE_KEY_ID=sk_live_placeholder
STRIPE_KEY_SECRET=sk_secret_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Ads & Analytics
SITE_ADSENSE_CLIENT=ca-pub-8977523182593956
SITE_GTAG_ID=G-DPSML6XTSC

# Security
FREE_USES_DEFAULT=10
SESSION_TIMEOUT=7200
